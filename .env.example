# Sanitized example. Copy to .env.local and fill in. NEVER commit real values.
# All of these are server-only: none may use the NEXT_PUBLIC_ prefix.

# fixtures (default): Phase 1 recorded synthetic fixtures. No database needed.
# memory:   explicit development mode, signals live in server memory and reset on restart.
# database: Supabase Postgres (requires DATABASE_URL and `npm run db:migrate`).
DATA_SOURCE=fixtures

# Supabase: Project Settings > Database > Connection string > "Session pooler" (the direct connection is
# IPv6-only). Use a SYNTHETIC-DATA project, not a production one.
DATABASE_URL=

# Bearer key for POST /api/signals. Generate with: openssl rand -hex 32
INGEST_API_KEY=

# Tenant the ingest key maps to (set on the server, never taken from a request).
DEMO_TENANT_ID=tenant-demo

# Shows the "Submit synthetic signal" sheet on Live Activity. Requires DATA_SOURCE=memory or database.
ENABLE_SYNTHETIC_SUBMIT=false

# Shows "Open investigation" (held signals) and "Re-run investigation" (cases). Requires DATA_SOURCE=memory or
# database, a signed-in session, and this flag.
ENABLE_OPERATOR_ACTIONS=false

# HMAC key for the signed session cookie (min 32 characters). Generate with: openssl rand -hex 32
SESSION_SECRET=

# Passwords for the three seeded synthetic demo users. Leave blank to skip seeding that user. Hashes only are stored.
DEMO_REVIEWER_PASSWORD=
DEMO_PROCUREMENT_PASSWORD=
DEMO_MANAGER_PASSWORD=

# Optional Google sign-in. Set both, or leave both blank. Create an OAuth client (Web) and register
# {origin}/api/auth/google/callback — http://localhost:3000/api/auth/google/callback for local development.
# The secret stays on the server. New Google accounts are reviewers.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Phase 4 AI fact extraction (docs/ai-extraction.md). none (default) | mock | ollama.
# mock is deterministic regular expressions, not a model. ollama calls a LOCAL server only; there is no
# remote provider and no fallback between providers. Suggestions are shown to people, never used in calculations.
AI_PROVIDER=none
# Must be a loopback address (localhost, 127.x.x.x or [::1]); anything else is rejected at startup.
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# Required when AI_PROVIDER=ollama, e.g. after `ollama pull qwen2.5:3b`.
# OLLAMA_MODEL=qwen2.5:3b
# Per-attempt timeout, 1000-60000 ms (default 15000), and retries after a timeout or invalid output, 0-2 (default 1).
# AI_TIMEOUT_MS=15000
# AI_MAX_RETRIES=1

# Optional: run the repository contract tests against a throwaway schema in a real database.
# TEST_DATABASE_URL=

# Optional: database pool size, 1-20 (default 5). Lower it if your pooler limits client connections.
# DATABASE_POOL_MAX=5

# Phase 6 MCP (docs/mcp-and-integrations.md). Bearer for POST /api/mcp. Separate from ingest. Tenant is always DEMO_TENANT_ID.
MCP_API_KEY=
# Per-tool timeout in ms, 500-30000 (default 5000).
# MCP_TOOL_TIMEOUT_MS=5000

# HTTPS source adapters (or http://127.0.0.1:3099 with npm run mock:sources). Both URL and key required, or both blank.
# Point at the mock: MAILBOX_BASE_URL=http://127.0.0.1:3099 and MAILBOX_API_KEY=mock-source-key-demo-only (same for ERP_/CARRIER_).
MAILBOX_BASE_URL=
MAILBOX_API_KEY=
ERP_BASE_URL=
ERP_API_KEY=
CARRIER_BASE_URL=
CARRIER_API_KEY=
